<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Security Team 3" version="21.0.0">
  <diagram id="topologia_byodsec" name="Topologia de Red BYODSEC">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ZONA 1: EXTERNA -->
        <mxCell id="sec_externa" value="Zona No Confiable (Internet / Redes Públicas)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontStyle=1;fontSize=12;fontColor=#334155;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;Dispositivo BYOD (PDI)&lt;/b&gt;&lt;br&gt;carmen_pdi&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;client cert X.509 v3 (clientAuth) + RSA 2048 + ca.crt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Dispositivo BYOD (PTGAS)&lt;/b&gt;&lt;br&gt;manuel_ptgas&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;client cert X.509 v3 (clientAuth) + RSA 2048 + ca.crt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Dispositivo BYOD (Investigador)&lt;/b&gt;&lt;br&gt;lucia_inv&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;client cert X.509 v3 (clientAuth) + RSA 2048 + ca.crt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0369a1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="atk" value="&lt;b&gt;Atacante Externo&lt;/b&gt;&lt;br&gt;Sin certificado → alert 116&lt;br&gt;Rogue CA → alert 48 (unknown_ca)&lt;br&gt;Evil Twin → cliente aborta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="lab" value="&lt;b&gt;Laboratorio real:&lt;/b&gt; Kali Linux (cliente)&lt;br&gt;→ Windows Host 192.168.1.21:8443" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="260" height="40" as="geometry"/>
        </mxCell>

        <!-- ZONA 2: PERIMETRO -->
        <mxCell id="sec_perimetro" value="Perímetro Corporativo U-Secure (DMZ)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;fontStyle=1;fontSize=12;fontColor=#0369a1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="340" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="fw" value="&lt;b&gt;Firewall Perimetral&lt;/b&gt;&lt;br&gt;Solo TCP 8443 entrante&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(regla del SO: Windows Defender Firewall)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="vpn" value="&lt;b&gt;Pasarela VPN Road Warrior&lt;/b&gt; (vpn_server.py)&lt;br&gt;0.0.0.0:8443 · vpn.usecure.edu.es&lt;br&gt;TLS 1.3 only · CERT_REQUIRED (mTLS)&lt;br&gt;ThreadPool 350 workers · RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e40af;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="200" width="280" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="pki" value="&lt;b&gt;U-Secure Root CA v1.3&lt;/b&gt; (pki_manager.py)&lt;br&gt;Emite server.crt (serverAuth) y client_*.crt (clientAuth)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;La pasarela solo usa ca.crt para validar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#166534;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="340" width="280" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Directorio Corporativo SQLite&lt;/b&gt; (database.py)&lt;br&gt;PBKDF2-HMAC-SHA256 600k · sal 128 bits&lt;br&gt;Rate limit 3 fallos → 60 s · Binding CN=usuario&lt;br&gt;Pool IP 10.8.0.0/22 · Sesiones · Auditoría" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#1e293b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="460" width="280" height="110" as="geometry"/>
        </mxCell>

